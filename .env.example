# Copy to .env.local to change where notes are saved. The default is local storage.

# Save through the REST adapter to an asynchronous in-browser mock of the API
# (the same as running `npm run dev:mock-api`):
# VITE_NOTES_STORAGE=mock-api

# Save through the REST adapter to a real server:
# VITE_NOTES_API_URL=http://localhost:3001
